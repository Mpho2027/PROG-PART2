@using RaceDay.Web.Infrastructure
@model List<ResultDto>
@{
    ViewData["Title"] = "My results";
    var placed = Model.Where(r => r.Position.HasValue).ToList();
    var best = placed.OrderBy(r => r.Position).FirstOrDefault();
}

<div class="page-header">
    <div>
        <span class="page-header__eyebrow">Participant</span>
        <h1 class="race-heading">My results</h1>
        <p>Your race history across every completed event you entered.</p>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="panel empty-state">
        <span class="material-symbols-rounded" aria-hidden="true">military_tech</span>
        <h2>No results yet</h2>
        <p class="mb-0">Results appear here once the organiser captures them after an event you entered.</p>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <span class="stat-card__icon"><span class="material-symbols-rounded" aria-hidden="true">flag</span></span>
                <div><div class="stat-card__value">@Model.Count</div><div class="stat-card__label">Race@(Model.Count == 1 ? "" : "s") finished</div></div>
            </div>
        </div>
        @if (best is not null)
        {
            <div class="col-sm-6 col-lg-3">
                <div class="stat-card">
                    <span class="stat-card__icon"><span class="material-symbols-rounded" aria-hidden="true">emoji_events</span></span>
                    <div><div class="stat-card__value">@Display.Ordinal(best.Position!.Value)</div><div class="stat-card__label">Best placing (@best.EventName)</div></div>
                </div>
            </div>
        }
    </div>

    @foreach (var r in Model)
    {
        <article class="result-card">
            <div class="result-card__position">
                <span>
                    <strong>@(r.Position.HasValue ? Display.Ordinal(r.Position.Value) : "-")</strong>
                    <small class="d-block">Place</small>
                </span>
            </div>
            <div>
                <h2 class="h4 mb-1">
                    <a asp-area="" asp-controller="Events" asp-action="Details" asp-route-id="@r.EventId" class="text-reset text-decoration-none">@r.EventName</a>
                </h2>
                <div class="text-muted">
                    @Display.Date(r.EventDate) &middot; @r.CategoryName &middot; Bib <span class="bib">@r.BibNumber</span>
                </div>
                @if (r.Position.HasValue)
                {
                    <div class="fw-semibold mt-1">@Display.Placing(r.Position.Value, r.Finishers)</div>
                }
            </div>
            <div class="result-card__time">
                @(r.FinishTime ?? "-")
                <small>Finish time</small>
            </div>
        </article>
    }
}
