@model CategoryFormViewModel
<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<section class="panel">
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="CategoryName" class="form-label"></label>
            <input asp-for="CategoryName" class="form-control" placeholder="e.g. 10km Race, Under 20, Senior" maxlength="100" />
            <span asp-validation-for="CategoryName" class="field-error"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="DistanceKm" class="form-label"></label>
            <input asp-for="DistanceKm" type="number" step="0.1" min="0.1" class="form-control" placeholder="Leave empty for an age category" />
            <span asp-validation-for="DistanceKm" class="field-error"></span>
        </div>
        <div class="col-6 col-md-3">
            <label asp-for="MinAge" class="form-label"></label>
            <input asp-for="MinAge" type="number" min="0" max="120" class="form-control" />
            <span asp-validation-for="MinAge" class="field-error"></span>
        </div>
        <div class="col-6 col-md-3">
            <label asp-for="MaxAge" class="form-label"></label>
            <input asp-for="MaxAge" type="number" min="0" max="120" class="form-control" />
            <span asp-validation-for="MaxAge" class="field-error"></span>
        </div>
        <div class="col-6 col-md-3">
            <label asp-for="MaxParticipants" class="form-label"></label>
            <input asp-for="MaxParticipants" type="number" min="1" class="form-control" />
            <span asp-validation-for="MaxParticipants" class="field-error"></span>
        </div>
        <div class="col-6 col-md-3">
            <label asp-for="EntryFee" class="form-label"></label>
            <input asp-for="EntryFee" type="number" min="0" step="0.01" class="form-control" />
            <span asp-validation-for="EntryFee" class="field-error"></span>
        </div>
    </div>
    <p class="form-text mb-0 mt-3">For an age category leave the distance empty and set the ages, for example a maximum age of 19 for "Under 20".</p>
</section>
