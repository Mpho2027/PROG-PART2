@model RegisterViewModel
@{
    ViewData["Title"] = "Create an account";
}

<div class="auth-wrap">
    <div class="auth-card auth-card--wide">
        <div class="auth-card__header">
            <span class="material-symbols-rounded auth-card__icon" aria-hidden="true">sprint</span>
            <h1 class="race-heading">Create an account</h1>
            <p class="text-muted mb-0">Join as a participant to enter events, or as an organiser to run them.</p>
        </div>

        <form asp-action="Register" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <fieldset class="mb-4">
                <legend class="form-label">@Html.DisplayNameFor(m => m.Role)</legend>
                <div class="role-picker">
                    <label class="role-option">
                        <input type="radio" asp-for="Role" value="@Roles.Participant" />
                        <span class="role-option__body">
                            <span class="material-symbols-rounded" aria-hidden="true">directions_run</span>
                            <strong>Participant</strong>
                            <small>Enter events and follow my results</small>
                        </span>
                    </label>
                    <label class="role-option">
                        <input type="radio" asp-for="Role" value="@Roles.Organiser" />
                        <span class="role-option__body">
                            <span class="material-symbols-rounded" aria-hidden="true">flag</span>
                            <strong>Organiser</strong>
                            <small>Create events and capture results</small>
                        </span>
                    </label>
                </div>
                <span asp-validation-for="Role" class="field-error"></span>
            </fieldset>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" autocomplete="name" />
                    <span asp-validation-for="FullName" class="field-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" />
                    <span asp-validation-for="PhoneNumber" class="field-error"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="field-error"></span>
                    <div class="form-text">At least 8 characters.</div>
                </div>
                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100 mt-4">Create account</button>
        </form>

        <p class="auth-card__switch">Already registered? <a asp-action="Login">Log in</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
