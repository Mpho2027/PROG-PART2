@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="message-page">
    <span class="material-symbols-rounded message-page__icon" aria-hidden="true">error</span>
    <h1 class="race-heading">Something went wrong</h1>
    <p class="text-muted">We couldn't complete that request. Please go back and try again.</p>
    @if (Model?.ShowRequestId == true)
    {
        <p class="small text-muted">Reference: <code>@Model.RequestId</code></p>
    }
    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to events</a>
</div>
