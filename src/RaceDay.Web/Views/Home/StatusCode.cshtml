@model int
@{
    var notFound = Model == 404;
    ViewData["Title"] = notFound ? "Page not found" : "Something went wrong";
}

<div class="message-page">
    <span class="material-symbols-rounded message-page__icon" aria-hidden="true">@(notFound ? "wrong_location" : "error")</span>
    <h1 class="race-heading">@(notFound ? "We couldn't find that page" : "Something went wrong")</h1>
    <p class="text-muted">
        @(notFound ? "The page or event you are looking for does not exist, or it may have been removed." : "Please go back and try again.")
    </p>
    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to events</a>
</div>
